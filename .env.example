# Docker Hub images
DOCKER_USERNAME=your_dockerhub_username
BACKEND_IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FRONTEND_IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URLs
REACT_APP_API_URL=https://your-domain.com/api
REACT_APP_WS_URL=wss://your-domain.com/ws
REACT_APP_MINIO_URL=https://your-domain.com/minio

# Backend runtime
MYSQL_DATABASE=ez_tro_prod
MYSQL_USER=ez_tro_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=360000000
FILE_UPLOAD_DIR=/uploads
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_DEBUG=false

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ez-tro
MINIO_BASE_PATH=/uploads
