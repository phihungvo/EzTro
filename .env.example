# Docker Hub
DOCKER_USERNAME=your_dockerhub_username
BACKEND_IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FRONTEND_IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App domain
APP_DOMAIN=your-domain.com

# MySQL
MYSQL_DATABASE=ez_tro_prod
MYSQL_USER=ez_tro_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Backend runtime
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ez_tro_prod?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=ez_tro_user
SPRING_DATASOURCE_PASSWORD=change_me_strong_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=360000000
FILE_UPLOAD_DIR=/uploads
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
MANAGEMENT_HEALTH_REDIS_ENABLED=true

# Backend must use the internal MinIO endpoint on the Docker network.
# Do not add a `/minio` path here.
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ez-tro
MINIO_BASE_PATH=/uploads
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_DEBUG=false

# Frontend build-time env
REACT_APP_API_URL=http://your-domain.com/api
REACT_APP_WS_URL=ws://your-domain.com/ws
REACT_APP_MINIO_URL=http://your-domain.com/minio
