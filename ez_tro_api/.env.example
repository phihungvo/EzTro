APP_NAME=TEVC_CMS
SPRING_PROFILES_ACTIVE=dev

LOG_LEVEL=INFO
SERVER_PORT=8080
CONTEXT_PATH=/
FRONTEND_URL=http://localhost:3000

# ================== DATABASE ==================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dev_cms?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=password

# ================== APPLICATION ==================
DEFAULT_ROLE=USER
CONTRACT_CODE_PREFIX=HD-
BILL_CODE_PREFIX=BL-
DEFAULT_ROOM_START_NUMBER=101
TIMESTAMP_FORMAT_CODE=yyyyMMddHHmmss

# ================== SYSTEM CONFIG ==================
DEFAULT_PLAN_ID=1

# ================== GOOGLE ==================
GOOGLE_CLIENT_ID=your_google_client_id

# ================== REDIS ==================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CLUSTER=false

SPRING_DATA_REDIS_SSL=false
SPRING_REDIS_CLUSTER_ENABLED=false

# ================== MAIL ==================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEBUG=false

# ================== JWT ==================
JWT_SECRET=your_base64_secret_key
JWT_EXPIRATION=360000000

# ================== MINIO ==================
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tevc-cms
MINIO_BASE_PATH=uploads

# ================== FILE ==================
FILE_UPLOAD_DIR=./uploads

# ================== SECURITY ==================
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_ENABLED=false

# ================== CRON JOB ==================
CONTRACT_STATUS_SYNC_CRON=0 10 0 * * *
CONTRACT_STATUS_SYNC_BATCH_SIZE=100

# ================== BILLING ==================
BILLING_DISCREPANCY_THRESHOLD=0.01

BILLING_REMINDER_DAYS=3,1
BILLING_REMINDER_CRON=0 30 8 * * ?

BILLING_PENALTY_GRACE_DAYS=0
BILLING_PENALTY_FIXED_FEE=0
BILLING_PENALTY_PERCENT_FEE=0
BILLING_PENALTY_DAILY_AMOUNT=50000
BILLING_PENALTY_DAILY_THRESHOLD_DAYS=3
BILLING_PENALTY_PERCENT_THRESHOLD_DAYS=10
BILLING_PENALTY_PERCENT_RATE=0.0

# ================== NOTIFICATION ==================
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_RETRY_BACKOFF_MINUTES=15
NOTIFICATION_DELIVERY_PROCESSOR_DELAY_MS=60000

NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_SMS_SIMULATE=true

NOTIFICATION_ZALO_ENABLED=false
NOTIFICATION_ZALO_SIMULATE=true

# ================== INCIDENT ==================
INCIDENT_ESCALATION_CRON=0 0 9 * * ?
INCIDENT_PENDING_ESCALATION_HOURS=48