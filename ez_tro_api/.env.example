APP_NAME="TEVC_CMS"

LOG_LEVEL=INFO
SERVER_PORT=8080
CONTEXT_PATH=/
FRONTEND_URL=http://localhost:3000

# Database configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dev_cms?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=password

# ID của gói dịch vụ mặc định (ví dụ: gói miễn phí)
DEFAULT_PLAN_ID=1

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=406925974910-k316qc1j9lb2liv80pqmrnvur8cg8h96.apps.googleusercontent.com

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_SSL=false
REDIS_CLUSTER=false

# Spring Data Redis configuration
SPRING_DATA_REDIS_SSL=false
SPRING_REDIS_CLUSTER_ENABLED=false

MAIL_DRIVER=SMTP
MAIL_HOST=smtp.googlemail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=SSL
MAIL_DEBUG=false

# JWT configuration
JWT_SECRET=Q2VwQ2h1bGxQb3J0YWxTdHJpbmdTdXBlclNlY3JldEtleTEyMzQ1Ng==
JWT_EXPIRATION=360000000

# MinIO configuration
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=tevc-cms
MINIO_BASE_PATH=uploads

# Directory for file uploads
FILE_UPLOAD_DIR=/path/to/upload/directory

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_ENABLED=false

# Cron job configuration for contract status synchronization
CONTRACT_STATUS_SYNC_CRON="0 10 0 * * *"
CONTRACT_STATUS_SYNC_BATCH_SIZE=100